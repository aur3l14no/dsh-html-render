{
  "name": "@local/dsh-html-render",
  "version": "0.1.0",
  "private": true,
  "description": "Lets DSH agents answer with an HTML page: they check it in headless Chrome, then show it in the chat.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/host/**",
    "src/shared/**",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "snapshot-theme": "node scripts/snapshot-theme.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "esbuild": "0.28.2"
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aur3l14no/dsh-html-render.git"
  },
  "homepage": "https://github.com/aur3l14no/dsh-html-render#readme"
}
